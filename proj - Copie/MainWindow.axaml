<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:ctrl="clr-namespace:BanStatsApp.Controllers"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        Width="1150" Height="760"
        MinWidth="900" MinHeight="600"
        x:Class="BanStatsApp.MainWindow"
        x:DataType="ctrl:MainWindowController"
        Title="Ban stats app - League statistics"
        WindowStartupLocation="CenterScreen">

        <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F3E8FF" Offset="0.0" />
            <GradientStop Color="#EDE9FE" Offset="0.4" />
            <GradientStop Color="#E2E8F0" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,18,24,18">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="League statistics"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           LetterSpacing="-0.5" />
                <TextBlock Text="season 12 and 13 banrate"
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="#475569"
                           Margin="0,2,0,0" />
            </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Name="ZoomInButton"
                        Content="＋ Zoom In"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Foreground="#334155" />
                <Button Name="ZoomOutButton"
                        Content="－ Zoom Out"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Foreground="#334155" />
                <Button Name="ResetZoomButton"
                        Content="↺ Reset View"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Foreground="#334155" />
                <Button Name="ExportButton"
                        Content="📥 Export CSV"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#E0247C"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="2.2*,1*">
                        <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="16"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    BoxShadow="0 4 16 0 #14000000"
                    Padding="16"
                    Margin="0,0,16,0">
                <ScottPlot:AvaPlot Name="MainPlot" />
            </Border>

                        <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14">
                                        <Border Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #0A000000"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Metrics &amp; Series"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />

                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0"
                                          Content="Banrate"
                                          IsChecked="{Binding ShowBanRate}"
                                          FontWeight="Medium"
                                          Foreground="#1E293B" />
                                <Border Grid.Column="1"
                                        Width="48"
                                        Height="3"
                                        Background="#E0247C"
                                        CornerRadius="1.5"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                                        <Border Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #0A000000"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Filter Parameters"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />

                                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="Champion:"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium"
                                           Foreground="#334155"
                                           Margin="0,0,8,0" />
                                <Border Grid.Column="1"
                                        Background="#F1F5F9"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding ChampionName}"
                                               FontWeight="Bold"
                                               Foreground="#E0247C"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>

                                                        <StackPanel Spacing="4">
                                <TextBlock Text="Season Filter:"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#64748B" />
                                <ComboBox ItemsSource="{Binding AvailableSeasons}"
                                          SelectedItem="{Binding SelectedSeason}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="6" />
                            </StackPanel>

                                                        <StackPanel Spacing="4">
                                <TextBlock Text="Patch Filter:"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#64748B" />
                                <ComboBox ItemsSource="{Binding AvailablePatches}"
                                          SelectedItem="{Binding SelectedPatch}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>



                                        <Border Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #0A000000"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Global Statistics"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" Margin="0,4,0,0">
                                                                <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Current" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Summary.CurrentRate, StringFormat='{}{0:F2}%'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                    </StackPanel>
                                </Border>

                                                                <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Average" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Summary.AverageRate, StringFormat='{}{0:F2}%'}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" />
                                    </StackPanel>
                                </Border>

                                                                <Border Grid.Row="1" Grid.Column="0" Background="#FDF2F8" CornerRadius="8" Padding="10,6" Margin="0,4,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Peak" FontSize="11" Foreground="#BE185D" />
                                        <TextBlock Text="{Binding Summary.MaxRate, StringFormat='{}{0:F2}%'}" FontSize="15" FontWeight="Bold" Foreground="#BE185D" />
                                    </StackPanel>
                                </Border>

                                                                <Border Grid.Row="1" Grid.Column="1" Background="#F0FDF4" CornerRadius="8" Padding="10,6" Margin="4,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Lowest" FontSize="11" Foreground="#15803D" />
                                        <TextBlock Text="{Binding Summary.MinRate, StringFormat='{}{0:F2}%'}" FontSize="15" FontWeight="Bold" Foreground="#15803D" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

                <Border Grid.Row="2"
                Background="#FFFFFF"
                CornerRadius="8"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="12,6"
                Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#475569"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Ban stats app • Avalonia &amp; ScottPlot"
                           FontSize="11"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
